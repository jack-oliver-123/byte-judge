COMPOSE_PROJECT_NAME=byte-judge
MYSQL_ROOT_PASSWORD=GENERATED_BY_INIT
MYSQL_USER_PASSWORD=GENERATED_BY_INIT
MYSQL_PROBLEM_PASSWORD=GENERATED_BY_INIT
MYSQL_SUBMISSION_PASSWORD=GENERATED_BY_INIT
MYSQL_CONTEST_PASSWORD=GENERATED_BY_INIT
REDIS_PASSWORD=GENERATED_BY_INIT
REDIS_PORT=16379
RABBITMQ_USER=bytejudge
RABBITMQ_PASSWORD=GENERATED_BY_INIT
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_CONFIG_NAMESPACE=
NACOS_CONFIG_GROUP=BYTE_JUDGE
NACOS_DISCOVERY_NAMESPACE=
NACOS_DISCOVERY_GROUP=BYTE_JUDGE
BYTE_JUDGE_INTERNAL_GATEWAY_CREDENTIAL=GENERATED_BY_INIT
# Dedicated credential for the problem service's private identity verification calls.
BYTE_JUDGE_INTERNAL_PROBLEM_CREDENTIAL=GENERATED_BY_INIT
# Snowflake worker/data-center pair; every concurrently running user-service instance needs a unique pair.
BYTE_JUDGE_AUDIT_WORKER_ID=0
BYTE_JUDGE_AUDIT_DATACENTER_ID=0
# Snowflake pair for the problem service; must differ from every other concurrent instance's pair.
BYTE_JUDGE_PROBLEM_WORKER_ID=1
BYTE_JUDGE_PROBLEM_DATACENTER_ID=0
# Root of the protected test-artifact volume used by the problem service.
BYTE_JUDGE_ARTIFACT_ROOT=.local/artifacts
NACOS_AUTH_TOKEN=GENERATED_BY_INIT
NACOS_AUTH_IDENTITY_KEY=GENERATED_BY_INIT
NACOS_AUTH_IDENTITY_VALUE=GENERATED_BY_INIT
